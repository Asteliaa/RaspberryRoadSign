
# Внутренний файл: экспорт best.pt -> NCNN (для подготовки артефакта)
# Сборка:
#   docker build --network=host -f docker/Dockerfile.export -t rrs-export .
#
# Запуск экспорта:
#   docker run --rm \
#     -v $(pwd)/models/deploy:/models \
#     -v $(pwd)/output_ncnn:/output \
#     rrs-export

FROM python:3.11-slim

# Системные зависимости для ultralytics NCNN экспорта
# pnnx (конвертер onnx→ncnn) требует libgomp и cmake
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgl1 \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем torch CPU-only (нет смысла тащить CUDA для экспорта)
RUN pip install --no-cache-dir \
    torch==2.5.1+cpu \
    torchvision==0.20.1+cpu \
    --index-url https://download.pytorch.org/whl/cpu

# Ultralytics — фиксируем версию для стабильности NCNN экспорта
RUN pip install --no-cache-dir \
    ultralytics==8.3.204 \
    onnx==1.17.0 \
    onnxruntime==1.20.1 \
    ncnn \
    numpy==1.26.4 \
    Pillow==10.4.0 \
    PyYAML==6.0.2 \
    opencv-python-headless==4.10.0.84
WORKDIR /workspace

# Скрипт экспорта
COPY docker/export_ncnn.py /workspace/export_ncnn.py

# Модель монтируется снаружи через -v
# /models/best.pt  →  входной файл
# /output/         →  куда кладём best_ncnn_model/

CMD ["python", "/workspace/export_ncnn.py"]
