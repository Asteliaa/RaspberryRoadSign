# RaspberryRoadSign Environment Configuration

# Model Paths
MODEL_PATH=models/v1/best.pt
DATA_PATH=datasets/rtsd_yolo

# Training Configuration
CUDA_VISIBLE_DEVICES=0
BATCH_SIZE=24
NUM_EPOCHS=50
LEARNING_RATE=0.002
DEVICE=cuda

# Inference Configuration
CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.45
DEVICE=cuda

# Data Paths
TRAIN_DATA_PATH=datasets/rtsd_yolo/images/train
VAL_DATA_PATH=datasets/rtsd_yolo/images/val
TEST_VIDEO_PATH=test_video/driving_lesson_11-13min.mp4

# Output Paths
OUTPUT_RESULTS_PATH=test_results/
OUTPUT_MODEL_PATH=models/v1/

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/raspberry_road_sign.log

# Optional: Weights & Biases (if using)
# WANDB_API_KEY=your_key_here
# WANDB_PROJECT=raspberry-road-sign
